<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blockchain Facial Authentication</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
  <style>
    .video-container {
      width: 400px;
      height: 300px;
      border: 1px solid #ccc;
      margin: 20px auto;
      position: relative;
    }
    #video {
      width: 100%;
      height: 100%;
    }
    .controls {
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <h1 class="text-center mb-4">Blockchain Facial Authentication</h1>
    
    <div class="row">
      <div class="col-md-8 offset-md-2">
        <div class="card">
          <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" id="authTabs">
              <li class="nav-item">
                <a class="nav-link active" id="register-tab" data-bs-toggle="tab" href="#register">Register</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" id="verify-tab" data-bs-toggle="tab" href="#verify">Verify</a>
              </li>
            </ul>
          </div>
          <div class="card-body">
            <div class="tab-content">
              <div class="tab-pane fade show active" id="register">
                <h5 class="card-title">Register Your Face</h5>
                <div class="video-container">
                  <video id="video-register" autoplay></video>
                </div>
                <div class="controls text-center">
                  <button class="btn btn-primary" id="capture-btn">Capture Face</button>
                  <button class="btn btn-success" id="register-btn" disabled>Register on Blockchain</button>
                </div>
                <div class="alert alert-info mt-3" id="register-status" style="display: none;"></div>
              </div>
              
              <div class="tab-pane fade" id="verify">
                <h5 class="card-title">Verify Your Identity</h5>
                <div class="video-container">
                  <video id="video-verify" autoplay></video>
                </div>
                <div class="controls text-center">
                  <button class="btn btn-primary" id="verify-capture-btn">Capture Face</button>
                  <button class="btn btn-success" id="verify-btn" disabled>Verify Identity</button>
                </div>
                <div class="alert mt-3" id="verify-status" style="display: none;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/web3@1.8.0/dist/web3.min.js"></script>
  <script src="app.js"></script>
</body>
</html>
